<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">


    <!-- ===================================================== -->
    <!-- ENCABEZADO DE FECHA -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvEncabezadoFecha"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="4dp"

        android:textColor="#165B5E"
        android:textSize="15sp"
        android:textStyle="bold"

        android:visibility="gone"

        tools:text="@string/admin_history_today"
        tools:visibility="visible" />


    <!-- ===================================================== -->
    <!-- TARJETA DEL PEDIDO -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"

        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="22dp"
        app:cardElevation="2dp"

        app:strokeColor="#ECECEC"
        app:strokeWidth="1dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">


            <!-- ================================================= -->
            <!-- CABECERA -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="center_vertical"
                android:orientation="horizontal">


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"

                    android:layout_weight="1"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/tvNumeroPedido"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:textColor="#171717"
                        android:maxLines="1"
                        android:textSize="20sp"
                        android:textStyle="bold"

                        tools:text="@string/admin_order_number_preview" />


                    <TextView
                        android:id="@+id/tvFechaPedido"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="4dp"

                        android:textColor="#777777"
                        android:textSize="13sp"

                        tools:text="@string/admin_order_date_preview" />

                    <TextView
                        android:id="@+id/tvCodigoSolicitud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:visibility="gone" />


                </LinearLayout>


                <!-- ESTADO -->

                <TextView
                    android:id="@+id/tvEstadoPedido"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginStart="12dp"

                    android:background="#E8F5E9"

                    android:gravity="center"
                    android:minHeight="36dp"

                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"

                    android:textColor="#2E7D32"
                    android:textSize="12sp"
                    android:textStyle="bold"

                    tools:text="@string/admin_order_status_preview" />


            </LinearLayout>


            <!-- ================================================= -->
            <!-- CLIENTE -->
            <!-- ================================================= -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                app:cardBackgroundColor="#FAFAFA"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"

                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="14dp">


                    <TextView
                        android:id="@+id/tvNombreUsuario"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:textColor="#222222"
                        android:textSize="18sp"
                        android:textStyle="bold"

                        tools:text="@string/admin_order_customer_preview" />


                    <TextView
                        android:id="@+id/tvTelefono"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="5dp"

                        android:textColor="#666666"
                        android:textSize="14sp"

                        tools:text="@string/admin_order_phone_preview" />


                </LinearLayout>


            </com.google.android.material.card.MaterialCardView>


            <!-- DIVISOR -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"

                android:background="#EEEEEE" />


            <!-- ================================================= -->
            <!-- PRODUCTOS -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvProductos"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:lineSpacingExtra="4dp"

                android:textColor="#333333"
                android:textSize="15sp"

                tools:text="@string/admin_order_item_products_preview" />

            <TextView
                android:id="@+id/tvObservacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#666666"
                android:textSize="14sp"
                android:visibility="gone" />


            <!-- ================================================= -->
            <!-- ENTREGA -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTipoEntrega"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"

                tools:text="@string/admin_order_delivery_type_preview" />


            <TextView
                android:id="@+id/tvDireccion"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:textColor="#555555"
                android:textSize="15sp"

                tools:text="@string/admin_order_address_preview" />


            <TextView
                android:id="@+id/tvReferencia"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="4dp"

                android:textColor="#777777"
                android:textSize="14sp"

                tools:text="@string/admin_order_reference_preview" />


            <!-- ================================================= -->
            <!-- UBICACIÓN -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerUbicacion"

                style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                android:layout_width="match_parent"
                android:layout_height="50dp"

                android:layout_marginTop="12dp"

                android:minHeight="48dp"

                android:text="@string/pedido_admin_ver_ubicacion"
                android:textAllCaps="false"

                android:textColor="#E87520"
                android:textSize="14sp"
                android:textStyle="bold"

                android:visibility="gone"

                app:backgroundTint="#FFF8F2"
                app:cornerRadius="14dp"

                app:strokeColor="#E87520"
                app:strokeWidth="1dp"

                tools:visibility="visible" />


            <!-- ================================================= -->
            <!-- PAGO -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvMetodoPago"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:textColor="#555555"
                android:textSize="15sp"

                tools:text="@string/admin_order_payment_method_preview" />


            <!-- DIVISOR -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"

                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"

                android:background="#EEEEEE" />


            <!-- ================================================= -->
            <!-- TOTAL -->
            <!-- ================================================= -->

            <TextView
                android:id="@+id/tvTotal"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:gravity="end"

                android:textColor="#171717"
                android:textSize="23sp"
                android:textStyle="bold"

                tools:text="@string/admin_order_total_preview" />


            <!-- ================================================= -->
            <!-- ELIMINAR -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEliminarPedido"

                style="@style/Widget.MaterialComponents.Button.OutlinedButton"

                android:layout_width="wrap_content"
                android:layout_height="48dp"

                android:layout_gravity="end"
                android:layout_marginTop="12dp"

                android:minHeight="48dp"

                android:text="@string/admin_history_delete_order"
                android:textAllCaps="false"

                android:textColor="@color/admin_history_delete"

                android:visibility="gone"

                app:backgroundTint="#FFF8F7"
                app:cornerRadius="14dp"

                app:icon="@android:drawable/ic_menu_delete"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/admin_history_delete"

                app:rippleColor="@color/admin_history_delete_ripple"

                app:strokeColor="@color/admin_history_delete"
                app:strokeWidth="1dp"

                tools:visibility="visible" />


            <!-- ================================================= -->
            <!-- CAMBIO DE ESTADO -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutRevisionSolicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/solicitud_admin_revision_titulo"
                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/solicitud_admin_revision_detalle"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAprobarSolicitud"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:text="@string/solicitud_admin_aprobar"
                        android:textAllCaps="false"
                        app:backgroundTint="#2E7D32"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRechazarSolicitud"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:text="@string/solicitud_admin_rechazar"
                        android:textAllCaps="false"
                        android:textColor="#B3261E"
                        app:cornerRadius="14dp"
                        app:strokeColor="#B3261E" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCambiarEstado"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical">


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"

                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="14dp"

                    android:background="#EEEEEE" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="@string/admin_order_progress_title"

                    android:textColor="#333333"
                    android:textSize="15sp"
                    android:textStyle="bold" />


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="3dp"

                    android:text="@string/admin_order_progress_description"

                    android:textColor="#888888"
                    android:textSize="12sp" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:orientation="vertical">


                    <!-- FILA 1 -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:baselineAligned="false"
                        android:orientation="horizontal">


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConfirmado"

                            android:layout_width="0dp"
                            android:layout_height="52dp"

                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"

                            android:minHeight="48dp"

                            android:text="@string/admin_order_status_confirmed"
                            android:textAllCaps="false"

                            android:textColor="#FFFFFF"
                            android:textSize="13sp"

                            app:backgroundTint="#E87520"
                            app:cornerRadius="14dp"

                            app:rippleColor="#40FFFFFF" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPreparando"

                            android:layout_width="0dp"
                            android:layout_height="52dp"

                            android:layout_marginStart="5dp"
                            android:layout_weight="1"

                            android:minHeight="48dp"

                            android:text="@string/admin_order_status_preparing"
                            android:textAllCaps="false"

                            android:textColor="#FFFFFF"
                            android:textSize="13sp"

                            app:backgroundTint="#E87520"
                            app:cornerRadius="14dp"

                            app:rippleColor="#40FFFFFF" />


                    </LinearLayout>


                    <!-- FILA 2 -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="9dp"

                        android:baselineAligned="false"
                        android:orientation="horizontal">


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEnCamino"

                            android:layout_width="0dp"
                            android:layout_height="52dp"

                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"

                            android:minHeight="48dp"

                            android:text="@string/admin_order_status_on_the_way"
                            android:textAllCaps="false"

                            android:textColor="#FFFFFF"
                            android:textSize="13sp"

                            app:backgroundTint="#E87520"
                            app:cornerRadius="14dp"

                            app:rippleColor="#40FFFFFF" />


                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEntregado"

                            android:layout_width="0dp"
                            android:layout_height="52dp"

                            android:layout_marginStart="5dp"
                            android:layout_weight="1"

                            android:minHeight="48dp"

                            android:text="@string/admin_order_status_delivered"
                            android:textAllCaps="false"

                            android:textColor="#FFFFFF"
                            android:textSize="13sp"

                            app:backgroundTint="#2E7D32"
                            app:cornerRadius="14dp"

                            app:rippleColor="#40FFFFFF" />


                    </LinearLayout>


                </LinearLayout>


            </LinearLayout>


        </LinearLayout>


    </com.google.android.material.card.MaterialCardView>


</LinearLayout>