<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#D913474D"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="#6689B8BC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgExtraAdmin"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="centerInside"
            app:srcCompat="@android:drawable/ic_menu_gallery" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreExtraAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="@string/admin_extra_name_preview" />

            <TextView
                android:id="@+id/tvPrecioExtraAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FF9800"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="@string/admin_extra_price_preview" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEditarExtra"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_extra_edit_description"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_edit"
            app:tint="#D7E0E1" />


        <ImageButton
            android:id="@+id/btnEliminarExtra"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/admin_extra_delete_description"
            android:padding="12dp"
            app:srcCompat="@android:drawable/ic_menu_delete"
            app:tint="#D7E0E1" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
