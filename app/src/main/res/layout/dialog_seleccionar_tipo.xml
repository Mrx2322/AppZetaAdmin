<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#F20B343A"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeColor="#6689B8BC"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_titulo_seleccionar_tipo"
            android:textColor="@android:color/white"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp"
            android:text="@string/admin_seleccionar_tipo_ayuda"
            android:textColor="#BFD4D6"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTipoPlato"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical|start"
            android:text="@string/admin_tipo_plato"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#CC18515A"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_menu_manage"
            app:iconPadding="14dp"
            app:iconTint="#FFB066"
            app:strokeColor="#527CA3A8"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTipoEntrada"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="@string/admin_tipo_entrada"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#CC18515A"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            app:iconPadding="14dp"
            app:iconTint="#9AD6B5"
            app:strokeColor="#527CA3A8"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTipoExtra"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical|start"
            android:text="@string/admin_tipo_extra"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#CC18515A"
            app:cornerRadius="18dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconPadding="14dp"
            app:iconTint="#8FC8FF"
            app:strokeColor="#527CA3A8"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarTipo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="10dp"
            android:minWidth="0dp"
            android:text="@string/admin_cancelar"
            android:textAllCaps="false"
            android:textColor="#D2E3E5"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
